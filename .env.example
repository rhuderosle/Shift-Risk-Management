# Shift Risk Management System — configuration
# Copy to .env and adjust.

APP_TITLE=Shift Risk Management System
DB_PATH=data/shift_risk.db

# ---- Access control / hosting ----
# single_user = NO AUTHENTICATION (only safe on 127.0.0.1)
# header      = trust an authenticating reverse proxy (IIS Windows Auth)
AUTH_MODE=single_user
AUTH_USER_HEADER=X-Remote-User
AUTH_ALLOWED_USERS=
AUTH_ADMINS=
BIND_HOST=127.0.0.1
BIND_PORT=8086

# ---- Email ----
# transport: smtp | outlook
# "outlook" sends through your signed-in local Outlook profile (no password needed).
EMAIL_TRANSPORT=outlook
OUTLOOK_SEND_ACCOUNT=
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=shift-risk-bot@example.com
EMAIL_TO=shift.leads@example.com,ops.exec@example.com
EMAIL_ESCALATION_TO=ops.exec@example.com
# Set false to write emails to data/outbox/ instead of sending (safe for testing)
EMAIL_ENABLED=false
# SAFETY VALVE: while set, all mail is redirected here instead of real recipients.
EMAIL_REDIRECT_TO=

# ---- Automated triggers ----
# Cron times (24h, local) at which the shift passdown email is auto-sent
PASSDOWN_CRON_HOURS=7,19
PASSDOWN_CRON_MINUTE=0
# How often (minutes) to scan for new critical risks needing immediate escalation
ESCALATION_SCAN_MINUTES=10
# Automatic sending is opt-in and separate from EMAIL_ENABLED.
PASSDOWN_AUTO_SEND=false
ESCALATION_AUTO_SEND=false
SCHEDULER_ENABLED=true

# ---- MMS Passdown connector ----
# Internal shift-passdown web app. Uses Windows integrated auth as the account
# running this app. Set to your own site's passdown URL.
MMS_PASSDOWN_URL=http://<mms-host>/PassdownView.aspx?tabid=<n>&FAID=<n>&GID=<n>
MMS_SYNC_ENABLED=false
MMS_SYNC_MINUTES=30
MMS_TIMEOUT_SECONDS=90

# ---- Outlook connector (local COM, uses the running Outlook profile) ----
OUTLOOK_ENABLED=true
OUTLOOK_FOLDER=            # blank = Inbox; otherwise a top-level folder name
OUTLOOK_LOOKBACK_HOURS=24
OUTLOOK_MAX_ITEMS=200
OUTLOOK_TIMEOUT_SECONDS=180
OUTLOOK_SYNC_ENABLED=false
OUTLOOK_SYNC_MINUTES=30

# ---- HDMX file share (USDT, hot swap, waiting for spare) ----
# Structured CSVs that also back the "HDMX Performance KPI" Power BI report,
# so figures here match that dashboard. Needs a Windows account with rights
# to the share, i.e. an internal machine.
HDMX_ENABLED=true
HDMX_SHARE=\\<file-server>\HDMX
HDMX_SYNC_ENABLED=false
HDMX_SYNC_MINUTES=60
# Work weeks of utilisation archive to read when building trends.
HDMX_TREND_WEEKS=8

# ---- AI summarizer (optional) ----
# Leave blank to use the built-in deterministic rule-based summarizer.
# provider: none | openai | azure
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
