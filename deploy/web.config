<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse proxy providing Windows/Kerberos SSO in front of the dashboard.

  Prerequisites on the server:
    - IIS with URL Rewrite 2.1 and Application Request Routing (ARR) installed
    - ARR proxy enabled: Server node > Application Request Routing Cache >
      Server Proxy Settings > Enable proxy
    - This site: Authentication > Windows Authentication ENABLED,
                 Anonymous Authentication DISABLED

  How identity reaches the app: IIS authenticates the browser with Kerberos/NTLM,
  then the rule below copies the resulting login into the X-Remote-User header,
  which the app reads (AUTH_USER_HEADER).

  SECURITY - the critical bit: the app trusts that header completely. It MUST NOT
  be reachable except through this proxy, otherwise anyone can forge an identity
  by setting the header themselves. Keep BIND_HOST=127.0.0.1 so the app only
  listens on loopback, and make sure the inbound rule strips any client-supplied
  X-Remote-User before the server variable is set.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <allowedServerVariables>
        <add name="HTTP_X_REMOTE_USER" />
      </allowedServerVariables>
      <rules>
        <rule name="Strip client-supplied identity header" stopProcessing="false">
          <match url=".*" />
          <serverVariables>
            <!-- Overwrite unconditionally so a forged inbound header cannot survive. -->
            <set name="HTTP_X_REMOTE_USER" value="{LOGON_USER}" />
          </serverVariables>
          <action type="None" />
        </rule>

        <rule name="Proxy to Shift Risk app" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <!-- Only proxy once IIS has actually authenticated the caller. -->
            <add input="{LOGON_USER}" pattern=".+" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:8086/{R:1}" />
        </rule>
      </rules>
      <outboundRules>
        <rule name="Rewrite redirect Location header">
          <match serverVariable="RESPONSE_Location" pattern="^http://127\.0\.0\.1:8086/(.*)" />
          <action type="Rewrite" value="/{R:1}" />
        </rule>
      </outboundRules>
    </rewrite>
  </system.webServer>
</configuration>
